<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
    The library's own manifest declares no application theme - every consuming app supplies its
    own (e.g. GetIcon's CommonUtils.AppTheme at the <application> level). Standalone unit tests
    have no consuming app, so without this, activities using dev.oneuiproject.oneui.layout.AppInfoLayout
    inflate against AppCompat's default ActionBar theme and crash: AppInfoLayout's constructor calls
    setSupportActionBar(), which requires a NoActionBar theme. CommonUtils.AppTheme (parent
    OneUITheme) is also DayNight-capable, unlike a hardcoded Theme.AppCompat.Light - see
    lib/src/androidTest/AndroidManifest.xml for the same reasoning on the instrumented side.
    -->
    <application
        android:label="@string/app_name"
        android:theme="@style/CommonUtils.AppTheme">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="de.lemke.commonutils.test.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/test_file_provider_paths" />
        </provider>
    </application>
</manifest>
